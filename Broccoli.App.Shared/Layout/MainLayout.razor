@inherits LayoutComponentBase
@implements IDisposable
@inject IThemeService ThemeService
@inject INavStateService NavState
@inject IJSRuntime JS

<div class="page @(NavState.IsCollapsed ? "nav-collapsed" : "")">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <div class="top-row px-4">
            <button class="settings-btn" @onclick="OpenSettings" title="App Settings">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
            <AppSettingsDialog IsOpen="_settingsOpen" OnClose="CloseSettings" />
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _settingsOpen;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;

        bool osDark = await JS.InvokeAsync<bool>("window.getOsPrefersDark");
        await ThemeService.InitializeAsync(osDark);
        await JS.InvokeVoidAsync("window.setAppTheme",
            ThemeService.IsDarkMode ? "dark" : "light");

        ThemeService.OnThemeChanged += HandleThemeChanged;

        await NavState.InitializeAsync();
        NavState.OnChanged += HandleNavStateChanged;

        StateHasChanged();
    }

    private async void HandleThemeChanged()
    {
        await JS.InvokeVoidAsync("window.setAppTheme",
            ThemeService.IsDarkMode ? "dark" : "light");
        await InvokeAsync(StateHasChanged);
    }

    private void HandleNavStateChanged() => InvokeAsync(StateHasChanged);

    private void OpenSettings()  => _settingsOpen = true;
    private void CloseSettings() => _settingsOpen = false;

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
        NavState.OnChanged -= HandleNavStateChanged;
    }
}