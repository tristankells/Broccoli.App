@inject IAuthenticationStateService AuthStateService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Broccoli.App</a>
        <div class="nav-right">
            @if (AuthStateService.IsAuthenticated)
            {
                <span class="username">@AuthStateService.CurrentUsername</span>
                <button class="btn btn-sm btn-outline-light logout-btn" @onclick="Logout">Logout</button>
            }
            <label class="navbar-toggler-label" for="nav-toggle" title="Toggle navigation" aria-label="Toggle navigation"></label>
        </div>
    </div>
</div>

<input type="checkbox" id="nav-toggle" class="navbar-toggler-input" />
<label class="nav-backdrop" for="nav-toggle" aria-hidden="true"></label>
<div class="nav-scrollable" id="nav-scrollable">
    <div class="nav-close-row">
        <label class="nav-close-btn" for="nav-toggle" title="Close menu" aria-label="Close navigation">&#x2715;</label>
    </div>
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span aria-hidden="true">&#x1F37D;</span> Recipes
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="meal-prep">
                <span aria-hidden="true">&#x1F4CB;</span> Meal Prep
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="daily-food-planning">
                <span aria-hidden="true">&#x1F4C5;</span> Daily Food Planning
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="foods">
                <span aria-hidden="true">&#x1F957;</span> Food Database
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="grocery-list">
                <span aria-hidden="true">&#x1F6D2;</span> Grocery List
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="pantry">
                <span aria-hidden="true">&#x1F5C4;</span> Pantry
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="macro-targets">
                <span aria-hidden="true">&#x1F3AF;</span> Macro Targets
            </NavLink>
        </div>
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthStateService.OnAuthenticationStateChanged += OnAuthStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("navInterop.init");
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () => await JS.InvokeVoidAsync("navInterop.closeNav"));
    }

    private void OnAuthStateChanged() => InvokeAsync(StateHasChanged);

    private async Task Logout()
    {
        await AuthStateService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        AuthStateService.OnAuthenticationStateChanged -= OnAuthStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
