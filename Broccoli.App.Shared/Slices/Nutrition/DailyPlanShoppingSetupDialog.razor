@namespace Broccoli.App.Shared.Slices.Nutrition
@using Broccoli.Data.Models

@if (IsVisible)
{
    <div class="modal-backdrop" @onclick="Cancel"></div>
    <div class="modal-dialog-container" role="dialog" aria-modal="true" aria-labelledby="setup-dialog-title">
        <div class="modal-content-box">

            <!-- Header -->
            <div class="modal-header-bar">
                <h2 id="setup-dialog-title" class="modal-title-text">
                    🛒 Add to Shopping List
                </h2>
                <button class="modal-close-btn" @onclick="Cancel" title="Close">&times;</button>
            </div>

            <!-- Body -->
            <div class="modal-body-scroll">

                <!-- Section 1: Plan selection -->
                <div class="setup-section">
                    <h3 class="setup-section-heading">Select plans to shop for</h3>
                    <ul class="plan-list">
                        @foreach (var plan in AllPlans)
                        {
                            var isChecked   = _selectedPlanIds.Contains(plan.Id);
                            var foodCount   = GetPlanFoodCount(plan);
                            var recipeCount = GetPlanRecipeCount(plan);

                            <li class="plan-row">
                                <label class="plan-label">
                                    <input type="checkbox"
                                           class="plan-checkbox"
                                           checked="@isChecked"
                                           @onchange="() => TogglePlan(plan.Id)" />
                                    <span class="plan-name">@plan.Name</span>
                                </label>
                                <span class="plan-badge">
                                    @if (foodCount > 0)
                                    {
                                        <span>@foodCount food@(foodCount == 1 ? "" : "s")</span>
                                    }
                                    @if (recipeCount > 0)
                                    {
                                        @if (foodCount > 0) { <span>&nbsp;·&nbsp;</span> }
                                        <span>@recipeCount recipe@(recipeCount == 1 ? "" : "s")</span>
                                    }
                                    @if (foodCount == 0 && recipeCount == 0)
                                    {
                                        <span class="badge-empty">empty</span>
                                    }
                                </span>
                            </li>
                        }
                    </ul>
                </div>

                <!-- Section 2: Days multiplier -->
                <div class="setup-section">
                    <h3 class="setup-section-heading">Shopping for how many days?</h3>
                    <div class="days-pills">
                        @foreach (var preset in new[] { 1, 3, 5, 7 })
                        {
                            <button class="day-pill @(!_customDays && _days == preset ? "active" : "")"
                                    @onclick="() => SetDays(preset)">
                                @preset
                            </button>
                        }
                        <button class="day-pill @(_customDays ? "active" : "")"
                                @onclick="SetCustomDays">
                            Custom
                        </button>
                    </div>
                    @if (_customDays)
                    {
                        <div class="custom-days-row">
                            <input type="number"
                                   class="custom-days-input"
                                   min="1"
                                   max="30"
                                   @bind="_days"
                                   @bind:event="oninput" />
                            <span class="custom-days-label">days</span>
                        </div>
                    }
                </div>

                <!-- Section 3: Recipe options (only if selected plans have recipes) -->
                @{
                    var selectedRecipes = GetUniqueRecipesAcrossSelectedPlans();
                }
                @if (selectedRecipes.Any())
                {
                    <div class="setup-section">
                        <h3 class="setup-section-heading">Recipe options</h3>
                        <p class="setup-hint">
                            <strong>Plan-based:</strong> ingredients for exactly the servings you'll eat
                            (plan qty × days). &nbsp;
                            <strong>Full recipe:</strong> ingredients for the recipe as written
                            (recipe's default serving size).
                        </p>

                        @foreach (var recipe in selectedRecipes)
                        {
                            var settings    = _recipeSettings.GetValueOrDefault(recipe.Id) ?? new();
                            var occurrences = GetRecipeOccurrenceCount(recipe.Id);
                            var missing     = NoServingsWarning(recipe);

                            <div class="recipe-option-row">
                                <div class="recipe-option-header">
                                    <span class="recipe-option-name">@recipe.Name</span>
                                    @if (missing)
                                    {
                                        <span class="no-servings-warning" title="No serving count — defaulting to full recipe">⚠️ No serving count</span>
                                    }
                                    <span class="scale-summary">@ComputeScaleSummary(recipe)</span>
                                </div>

                                @if (!missing)
                                {
                                    <!-- Plan-based vs Full Recipe toggle -->
                                    <div class="segment-toggle">
                                        <button class="segment-btn @(!settings.UseFullRecipe ? "active" : "")"
                                                @onclick="() => { settings.UseFullRecipe = false; }">
                                            Plan-based
                                        </button>
                                        <button class="segment-btn @(settings.UseFullRecipe ? "active" : "")"
                                                @onclick="() => { settings.UseFullRecipe = true; }">
                                            Full recipe
                                        </button>
                                    </div>
                                }

                                <!-- Consolidate toggle — only for full recipe when recipe appears in 2+ plans -->
                                @if (settings.UseFullRecipe && occurrences > 1)
                                {
                                    <div class="segment-toggle consolidate-toggle">
                                        <button class="segment-btn @(settings.ConsolidateAcrossPlans ? "active" : "")"
                                                @onclick="() => { settings.ConsolidateAcrossPlans = true; }">
                                            1 batch (shared)
                                        </button>
                                        <button class="segment-btn @(!settings.ConsolidateAcrossPlans ? "active" : "")"
                                                @onclick="() => { settings.ConsolidateAcrossPlans = false; }">
                                            @occurrences batches (per plan)
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

            </div>

            <!-- Footer -->
            <div class="modal-footer-bar">
                <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
                <button class="btn btn-primary"
                        @onclick="PreviewAsync"
                        disabled="@_isBuilding">
                    @if (_isBuilding)
                    {
                        <span>Building…</span>
                    }
                    else
                    {
                        <span>Preview Ingredients →</span>
                    }
                </button>
            </div>

        </div>
    </div>
}
