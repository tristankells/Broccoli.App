<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Broccoli.Avalonia"
             x:Class="Broccoli.Avalonia.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>    

    <Application.Styles>
        <FluentTheme />
        <!-- Shared rotating spinner: add Classes="spinner" to any PathIcon to spin it infinitely. -->
        <Style Selector="PathIcon.spinner">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform />
                </Setter.Value>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="(RotateTransform.Angle)" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="(RotateTransform.Angle)" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- Recipe card hover: scale up for a "lift" feel. Cards supply the ScaleTransform
             + RenderTransformOrigin + Transitions in their template; this just drives the value. -->
        <Style Selector="Button.recipeCard:pointerover">
            <Setter Property="Panel.ZIndex" Value="10" />
            <Setter Property="(ScaleTransform.ScaleX)" Value="1.05" />
            <Setter Property="(ScaleTransform.ScaleY)" Value="1.05" />
        </Style>
        <!-- Gentle opacity pulse for attention states (e.g. the unsynced-changes glyph). -->
        <Style Selector="PathIcon.pulse">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- Keep tooltips readable in both themes: always pair an explicit background with a
             contrasting foreground so text never ends up light-on-light. -->
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ToolTipBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ToolTipForegroundBrush}" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="AppContentBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ConflictCardBackgroundBrush" Color="#FFF4E5" />
                    <SolidColorBrush x:Key="ConflictCardForegroundBrush" Color="#1E1E22" />
                    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToolTipForegroundBrush" Color="#1E1E22" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="#1E1E22" />
                    <SolidColorBrush x:Key="AppContentBackgroundBrush" Color="#2B2B30" />
                    <SolidColorBrush x:Key="ConflictCardBackgroundBrush" Color="#4B3A1E" />
                    <SolidColorBrush x:Key="ConflictCardForegroundBrush" Color="#F2EFE6" />
                    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#3A3A40" />
                    <SolidColorBrush x:Key="ToolTipForegroundBrush" Color="#F2F2F2" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>