<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Broccoli.Avalonia.Shared"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="200"
        x:Class="Broccoli.Avalonia.Shared.ConfirmDialog"
        x:DataType="vm:ConfirmDialogViewModel"
        Title="{Binding Title}"
        Width="460" SizeToContent="Height"
        Icon="/Assets/avalonia-logo.ico"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16" Spacing="16">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}"
                    Background="IndianRed" Foreground="White" Padding="20,6" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="20,6" />
        </StackPanel>
    </StackPanel>
</Window>
