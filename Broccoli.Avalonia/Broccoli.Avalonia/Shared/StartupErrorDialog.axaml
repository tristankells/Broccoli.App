<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Broccoli.Avalonia.Shared"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="520"
        x:Class="Broccoli.Avalonia.Shared.StartupErrorDialog"
        x:DataType="vm:StartupErrorDialogViewModel"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Data="M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                      Width="22" Height="22" Foreground="#E74C3C" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" LineHeight="21" />

        <TextBox Text="{Binding Details}" IsReadOnly="True" Height="110"
                 FontFamily="Consolas, Courier New, monospace" FontSize="11"
                 TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Error details" />

        <TextBlock Text="{Binding RetryError}" Foreground="#E74C3C" TextWrapping="Wrap"
                   IsVisible="{Binding HasRetryError}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" />
            <Button Content="Retry" Command="{Binding RetryCommand}" Classes="accent" IsEnabled="{Binding !IsRetrying}" />
            <Button Content="OK" Command="{Binding CloseCommand}" IsEnabled="{Binding !IsRetrying}" />
        </StackPanel>
    </StackPanel>
</Window>
