<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Broccoli.Avalonia.Shell"
             xmlns:views="using:Broccoli.Avalonia.Shell"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Broccoli.Avalonia.Shell.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
        to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- DrawerPage adapts automatically: below DrawerBreakpointLength the drawer collapses into
         a hamburger button (top bar) that opens an overlay drawer; above it a compact icon rail
         is shown and can expand inline. -->
    <DrawerPage Header="{Binding SelectedMenuItem.Title}"
                DrawerLayoutBehavior="CompactInline"
                DrawerBreakpointLength="600"
                CompactDrawerLength="56"
                DrawerLength="260"
                IsOpen="{Binding IsMenuOpen, Mode=TwoWay}"
                ContentTemplate="{x:Null}"
                DrawerBackground="{DynamicResource AppSidebarBackgroundBrush}"
                Background="{DynamicResource AppContentBackgroundBrush}">
        <DrawerPage.Drawer>
            <ListBox ItemsSource="{Binding VisibleMenuItems}"
                     SelectedItem="{Binding SelectedMenuItem}"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,6" Spacing="4">
                            <PathIcon Data="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center"
                                       IsVisible="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).IsMenuOpen}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DrawerPage.Drawer>
        <DrawerPage.Content>
            <Grid RowDefinitions="*,Auto">
                <TransitioningContentControl Grid.Row="0" Content="{Binding CurrentPage}" />
                <Border Grid.Row="1"
                        Background="{DynamicResource AppSidebarBackgroundBrush}"
                        BorderBrush="#40808080" BorderThickness="0,1,0,0"
                        Padding="12,3">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <views:SyncStatusFooterView Grid.Column="0" DataContext="{Binding SyncStatusFooter}" />
                        <views:StorageUsageFooterView Grid.Column="2" DataContext="{Binding StorageUsageFooter}" />
                    </Grid>
                </Border>
            </Grid>
        </DrawerPage.Content>
    </DrawerPage>
</UserControl>
