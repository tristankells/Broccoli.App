<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Broccoli.Avalonia.Shell"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="28"
             x:Class="Broccoli.Avalonia.Shell.StorageUsageFooterView"
             x:DataType="vm:StorageUsageFooterViewModel">
    <Design.DataContext>
        <vm:StorageUsageFooterViewModel />
    </Design.DataContext>

    <TextBlock Text="{Binding SummaryText}"
               FontSize="11"
               Foreground="Gray"
               HorizontalAlignment="Right"
               VerticalAlignment="Center">
        <ToolTip.Tip>
            <ToolTip>
                <StackPanel Spacing="3" MinWidth="200">
                    <TextBlock Text="Storage" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding BreakdownItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StorageBreakdownItem">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ToolTip>
        </ToolTip.Tip>
    </TextBlock>
</UserControl>
