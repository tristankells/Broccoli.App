<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Broccoli.Avalonia.Shell"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="28"
             x:Class="Broccoli.Avalonia.Shell.SyncStatusFooterView"
             x:DataType="vm:SyncStatusFooterViewModel">
    <Design.DataContext>
        <vm:SyncStatusFooterViewModel />
    </Design.DataContext>

    <!-- Clickable sync-status strip: shows an animated spinner while a sync runs, the last
         synced time, and a flag when local changes haven't been pushed yet. Clicking forces a
         sync now (disabled while Drive isn't connected). -->
    <Button Command="{Binding SyncNowCommand}"
            IsEnabled="{Binding SyncStatus.IsConnected}"
            Background="Transparent"
            BorderThickness="0"
            Padding="4,2"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <!-- Rotating spinner shown while a sync is in progress. -->
            <Grid Width="14" Height="14"
                  VerticalAlignment="Center"
                  RenderTransformOrigin="50%,50%"
                  IsVisible="{Binding SyncStatus.IsSyncing}"
                  Classes.spinning="{Binding SyncStatus.IsSyncing}">
                <Grid.RenderTransform>
                    <RotateTransform />
                </Grid.RenderTransform>
                <Grid.Styles>
                    <Style Selector="Grid.spinning">
                        <Style.Animations>
                            <Animation Duration="0:0:1" IterationCount="Infinite">
                                <KeyFrame Cue="0%">
                                    <Setter Property="(RotateTransform.Angle)" Value="0" />
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="(RotateTransform.Angle)" Value="360" />
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Grid.Styles>
                <PathIcon Data="M12,4V1L8,5L12,9V6C15.31,6 18,8.69 18,12C18,13.01 17.75,13.97 17.32,14.82L18.76,16.26C19.55,15.02 20,13.57 20,12C20,7.58 16.42,4 12,4M12,18C8.69,18 6,15.31 6,12C6,10.99 6.25,10.03 6.68,9.18L5.24,7.74C4.45,8.97 4,10.43 4,12C4,16.42 7.58,20 12,20V23L16,19L12,15V18Z"
                          Width="13" Height="13"
                          Foreground="Gray" />
            </Grid>

            <!-- Static sync glyph shown while connected and idle; doubles as a "click to sync" affordance. -->
            <PathIcon Data="M12,4V1L8,5L12,9V6C15.31,6 18,8.69 18,12C18,13.01 17.75,13.97 17.32,14.82L18.76,16.26C19.55,15.02 20,13.57 20,12C20,7.58 16.42,4 12,4M12,18C8.69,18 6,15.31 6,12C6,10.99 6.25,10.03 6.68,9.18L5.24,7.74C4.45,8.97 4,10.43 4,12C4,16.42 7.58,20 12,20V23L16,19L12,15V18Z"
                      Width="13" Height="13"
                      Foreground="Gray"
                      VerticalAlignment="Center"
                      IsVisible="{Binding ShowSyncIcon}" />

            <TextBlock Text="{Binding SummaryText}"
                       FontSize="11"
                       Foreground="Gray"
                       VerticalAlignment="Center" />
        </StackPanel>
        <ToolTip.Tip>
            <ToolTip>
                <StackPanel Spacing="3" MinWidth="200">
                    <TextBlock Text="Google Drive backup" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SummaryText}" />
                    <TextBlock Text="{Binding SyncStatus.LastSyncError}"
                               Foreground="Red"
                               IsVisible="{Binding SyncStatus.LastSyncError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="Click to sync now"
                               IsVisible="{Binding SyncStatus.IsConnected}"
                               Opacity="0.7" />
                    <TextBlock Text="Enable backup in Settings"
                               IsVisible="{Binding ShowEnableHint}"
                               Opacity="0.7" />
                </StackPanel>
            </ToolTip>
        </ToolTip.Tip>
    </Button>
</UserControl>
