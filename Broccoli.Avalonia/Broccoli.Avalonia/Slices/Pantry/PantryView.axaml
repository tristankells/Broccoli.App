<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Broccoli.Avalonia.Slices.Pantry"
             xmlns:models="using:Broccoli.Avalonia.Models"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
             x:Class="Broccoli.Avalonia.Slices.Pantry.PantryView"
             x:DataType="vm:PantryViewModel">
    <Design.DataContext>
        <vm:PantryViewModel />
    </Design.DataContext>

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Pantry" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />

        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="Red"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Margin="0,0,0,8" />

        <!-- Add item form -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,140,Auto" Margin="0,0,0,12">
            <TextBox Grid.Column="0" Text="{Binding NewItemName}" VerticalContentAlignment="Center"
                     PlaceholderText="Add an item..." />
            <ComboBox Grid.Column="1" SelectedIndex="{Binding NewItemCategory}" Margin="8,0" FontSize="12">
                <ComboBoxItem>Always Have</ComboBoxItem>
                <ComboBoxItem>Check If Have</ComboBoxItem>
            </ComboBox>
            <Button Grid.Column="2" Content="Add" Command="{Binding AddItemCommand}" Padding="16,6" />
        </Grid>

        <ScrollViewer>
            <StackPanel Spacing="16">
                <!-- Always Have section -->
                <Border Padding="12" CornerRadius="4" Background="{DynamicResource AppSidebarBackgroundBrush}"
                        BorderBrush="#2ECC71" BorderThickness="3,0,0,0"
                        IsVisible="{Binding HasAlwaysHaveItems}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Always Have" FontWeight="SemiBold" FontSize="14" Foreground="#2ECC71" />
                        <TextBlock Text="These are auto-unchecked when adding ingredients to your grocery list."
                                   Foreground="Gray" FontSize="11" FontStyle="Italic" />

                        <ItemsControl ItemsSource="{Binding AlwaysHaveItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:PantryItem">
                                    <Border Margin="0,1" Padding="8,4" CornerRadius="2">
                                        <Grid ColumnDefinitions="*,120,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding Name}"
                                                     VerticalContentAlignment="Center" FontSize="12" />
                                            <ComboBox Grid.Column="1" SelectedIndex="{Binding Category}" Margin="8,0" FontSize="11">
                                                <ComboBoxItem>Always Have</ComboBoxItem>
                                                <ComboBoxItem>Check If Have</ComboBoxItem>
                                            </ComboBox>
                                            <Button Grid.Column="2" Padding="4"
                                                    Command="{Binding $parent[ItemsControl].((vm:PantryViewModel)DataContext).DeleteItemCommand}"
                                                    CommandParameter="{Binding}">
                                                <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                                          Width="10" Height="10" Foreground="Red" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Check If Have section -->
                <Border Padding="12" CornerRadius="4" Background="{DynamicResource AppSidebarBackgroundBrush}"
                        BorderBrush="#F39C12" BorderThickness="3,0,0,0"
                        IsVisible="{Binding HasCheckIfHaveItems}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Check If Have" FontWeight="SemiBold" FontSize="14" Foreground="#F39C12" />
                        <TextBlock Text="These are checked by default when adding ingredients to your grocery list."
                                   Foreground="Gray" FontSize="11" FontStyle="Italic" />

                        <ItemsControl ItemsSource="{Binding CheckIfHaveItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:PantryItem">
                                    <Border Margin="0,1" Padding="8,4" CornerRadius="2">
                                        <Grid ColumnDefinitions="*,120,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding Name}"
                                                     VerticalContentAlignment="Center" FontSize="12" />
                                            <ComboBox Grid.Column="1" SelectedIndex="{Binding Category}" Margin="8,0" FontSize="11">
                                                <ComboBoxItem>Always Have</ComboBoxItem>
                                                <ComboBoxItem>Check If Have</ComboBoxItem>
                                            </ComboBox>
                                            <Button Grid.Column="2" Padding="4"
                                                    Command="{Binding $parent[ItemsControl].((vm:PantryViewModel)DataContext).DeleteItemCommand}"
                                                    CommandParameter="{Binding}">
                                                <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                                          Width="10" Height="10" Foreground="Red" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Empty state -->
                <TextBlock Text="Your pantry is empty. Add items above to track what you typically have at home."
                           Foreground="Gray" HorizontalAlignment="Center" FontSize="13"
                           IsVisible="{Binding !Items.Count}" Margin="0,24,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
