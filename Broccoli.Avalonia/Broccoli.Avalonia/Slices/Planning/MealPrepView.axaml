<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Broccoli.Avalonia.Slices.Planning"
             xmlns:models="using:Broccoli.Avalonia.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Broccoli.Avalonia.Slices.Planning.MealPrepView"
             x:DataType="vm:MealPrepViewModel">
    <Design.DataContext>
        <vm:MealPrepViewModel />
    </Design.DataContext>

    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Text="Meal Prep Plans" FontSize="22" FontWeight="Bold" />
            <Button Grid.Column="1" Content="＋ New Plan" Command="{Binding NewPlanCommand}" />
        </Grid>

        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="Red"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Margin="0,0,0,8" />

        <ScrollViewer>
            <StackPanel Spacing="8">
                <TextBlock Text="No plans yet." Foreground="Gray" HorizontalAlignment="Center"
                           IsVisible="{Binding !Plans.Count}" Margin="0,24,0,0" />

                <ItemsControl ItemsSource="{Binding Plans}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:MealPrepPlan">
                            <Border Padding="12" CornerRadius="6"
                                    Background="{DynamicResource AppSidebarBackgroundBrush}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding Name}"
                                                 FontWeight="SemiBold" FontSize="14"
                                                 VerticalContentAlignment="Center" />
                                        <Button Grid.Column="1" Content="Save" Classes="accent"
                                                Padding="8,4" FontSize="11" Margin="0,0,6,0"
                                                Command="{Binding $parent[ItemsControl].((vm:MealPrepViewModel)DataContext).SavePlanCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="2" Padding="4"
                                                Command="{Binding $parent[ItemsControl].((vm:MealPrepViewModel)DataContext).DeletePlanCommand}"
                                                CommandParameter="{Binding}">
                                            <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                                      Width="10" Height="10" Foreground="Red" />
                                        </Button>
                                    </Grid>

                                    <Separator />

                                    <TextBlock FontSize="11" Foreground="Gray">
                                        <Run Text="Recipes: " /><Run Text="{Binding RecipeIds.Count}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
