<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Broccoli.Avalonia.Slices.Recipes"
        x:Class="Broccoli.Avalonia.Slices.Recipes.AutoBalanceDialog"
        x:DataType="vm:AutoBalanceDialogViewModel"
        Title="Auto Balance Recipe" Width="580" SizeToContent="Height"
        Icon="/Assets/avalonia-logo.ico"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Spacing="6">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Auto Balance" />
            <TextBlock Text="{Binding TargetSummaryText}" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />

            <Border Margin="0,8,0,0" Padding="10" CornerRadius="4"
                    Background="{DynamicResource AppSidebarBackgroundBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Adjust" FontWeight="SemiBold" FontSize="13" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <CheckBox Content="Calories" IsChecked="{Binding AdjustCalories}" />
                        <CheckBox Content="Protein" IsChecked="{Binding AdjustProtein}" />
                        <CheckBox Content="Carbs" IsChecked="{Binding AdjustCarbs}" />
                        <CheckBox Content="Fat" IsChecked="{Binding AdjustFat}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding ShowFallbackWarning}" Margin="0,8,0,0" Padding="10" CornerRadius="4"
                    Background="#F39C12" Opacity="0.15">
                <TextBlock Text="Exact balancing wasn't possible (singular system or infeasible quantities); applied the single-pass heuristic instead."
                           FontSize="11" Foreground="#F39C12" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Apply changes" Command="{Binding ApplyCommand}" Classes="accent" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
            <StackPanel Spacing="12" Margin="0,8,0,0">
                <!-- Summary before/after -->
                <Border Padding="10" CornerRadius="4" Background="{DynamicResource AppContentBackgroundBrush}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Recipe total (overall)" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{Binding BeforeSummaryText}" FontSize="11" Foreground="Gray" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="→ " FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AfterSummaryText}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Per-serving target table -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Per serving vs target" FontWeight="SemiBold" FontSize="12" />
                    <Grid ColumnDefinitions="*,80,80,80,90" Margin="0,4,0,0">
                        <TextBlock Grid.Column="1" Text="Target" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Right" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="2" Text="Before" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Right" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="3" Text="After" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Right" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="4" Text="Δ (total)" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding TargetRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AutoBalanceTargetRow">
                                <Grid ColumnDefinitions="*,80,80,80,90">
                                    <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding TargetText}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding BeforeText}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding AfterText}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,8,0" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="{Binding DeltaText}" FontSize="11" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Contributor adjustments -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Largest contributors" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="{Binding Adjustments.Count, StringFormat='{}{0} ingredient(s) will be adjusted'}"
                               FontSize="10" Foreground="Gray" IsVisible="{Binding HasAdjustments}" />
                    <TextBlock Text="No adjustment needed — the recipe already matches the selected targets."
                               FontSize="10" Foreground="Gray"
                               IsVisible="{Binding !HasAdjustments}" />

                    <Grid ColumnDefinitions="*,90,90,90" Margin="0,4,0,0">
                        <TextBlock Grid.Column="1" Text="Before" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Right" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="2" Text="After" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Right" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="3" Text="Δ" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Adjustments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AutoBalanceAdjustmentRow">
                                <Border Margin="0,1" Padding="6,3" CornerRadius="2"
                                        Background="{DynamicResource AppSidebarBackgroundBrush}">
                                    <Grid ColumnDefinitions="*,90,90,90">
                                        <TextBlock Text="{Binding FoodName}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding BeforeText}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="Gray" />
                                        <TextBlock Grid.Column="2" Text="{Binding AfterText}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Text="{Binding DeltaText}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
