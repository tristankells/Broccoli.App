<UserControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:vm="using:Broccoli.Avalonia.Slices.Recipes"
                xmlns:conv="using:Broccoli.Avalonia.Shared.Converters"
                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                x:Class="Broccoli.Avalonia.Slices.Recipes.RecipeDetailView"
                x:DataType="vm:RecipeDetailViewModel">

    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12" MaxWidth="700" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding BackCommand}" Padding="6" Background="Transparent" BorderThickness="0">
                    <PathIcon Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"
                              Width="16" Height="16" />
                </Button>
                <TextBlock Text="{Binding Recipe.Name}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                <PathIcon IsVisible="{Binding Recipe.IsFavorite}"
                          Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z"
                          Width="16" Height="16" Foreground="Goldenrod" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button Command="{Binding EditCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                  Width="14" Height="14" />
                        <TextBlock Text="Edit" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RequestDeleteCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                  Width="14" Height="14" />
                        <TextBlock Text="Delete" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Inline delete confirmation -->
            <Border IsVisible="{Binding IsConfirmingDelete}" Background="#FFF4E5" CornerRadius="4" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Delete this recipe? This cannot be undone." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Delete" Command="{Binding ConfirmDeleteCommand}" Background="IndianRed" Foreground="White" />
                        <Button Content="Cancel" Command="{Binding CancelDeleteCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="{Binding Recipe.Servings, StringFormat='Servings: {0}'}"
                           IsVisible="{Binding Recipe.Servings, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{Binding Recipe.PrepTimeMinutes, StringFormat='Prep: {0} min'}"
                           IsVisible="{Binding Recipe.PrepTimeMinutes, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{Binding Recipe.CookTimeMinutes, StringFormat='Cook: {0} min'}"
                           IsVisible="{Binding Recipe.CookTimeMinutes, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding ImagePaths}" IsVisible="{Binding ImagePaths.Count}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding Converter={x:Static conv:FilePathToBitmapConverter.Instance}}"
                               Width="140" Height="140" Stretch="UniformToFill" Margin="0,0,8,8" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Ingredients" FontWeight="SemiBold" FontSize="16" Margin="0,8,0,0" />
            <TextBlock Text="{Binding Recipe.Ingredients}" TextWrapping="Wrap" />

            <!-- Meal Macro Comparison -->
            <Border Padding="10" CornerRadius="4"
                    Background="{DynamicResource AppSidebarBackgroundBrush}"
                    IsVisible="{Binding IsComparisonEnabled}">
                <StackPanel Spacing="6">
                    <TextBlock FontSize="13" FontWeight="SemiBold">
                        <Run Text="vs Target (" /><Run Text="{Binding ComparisonPersonName}" /><Run Text=")" />
                    </TextBlock>
                    <Grid ColumnDefinitions="Auto,70,70,70,70" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Target" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Right" Margin="0,0,6,0" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Actual" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Right" Margin="0,0,6,0" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Delta" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Right" Margin="0,0,6,0" />
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="% Off" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" />

                        <!-- Calories row -->
                        <Border Grid.Row="1" Grid.Column="0" Width="4" Background="#E74C3C" VerticalAlignment="Stretch" Margin="0,1" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Calories" FontSize="11" VerticalAlignment="Center" Margin="8,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MealTargetCalories, StringFormat='{}{0:0}'}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PerServingCalories, StringFormat='{}{0:0}'}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#E74C3C" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding CalDelta, StringFormat='{}{0:+0;-0;0}'}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <Border Grid.Row="1" Grid.Column="4" CornerRadius="8" Padding="4,1" HorizontalAlignment="Center"
                                Background="{Binding CalColor}">
                            <TextBlock Text="{Binding CalDeviationPct, StringFormat='{}{0:0}%'}" FontSize="10" Foreground="White" />
                        </Border>

                        <!-- Protein row -->
                        <Border Grid.Row="2" Grid.Column="0" Width="4" Background="#3498DB" VerticalAlignment="Stretch" Margin="0,1" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Protein" FontSize="11" VerticalAlignment="Center" Margin="8,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MealTargetProteinG, StringFormat='{}{0:0.0}g'}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding PerServingProteinG, StringFormat='{}{0:0.0}g'}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#3498DB" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding ProteinDelta, StringFormat='{}{0:+0.0;-0.0;0}'}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <Border Grid.Row="2" Grid.Column="4" CornerRadius="8" Padding="4,1" HorizontalAlignment="Center"
                                Background="{Binding ProteinColor}">
                            <TextBlock Text="{Binding ProteinDeviationPct, StringFormat='{}{0:0}%'}" FontSize="10" Foreground="White" />
                        </Border>

                        <!-- Carbs row -->
                        <Border Grid.Row="3" Grid.Column="0" Width="4" Background="#2ECC71" VerticalAlignment="Stretch" Margin="0,1" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Carbs" FontSize="11" VerticalAlignment="Center" Margin="8,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MealTargetCarbsG, StringFormat='{}{0:0.0}g'}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding PerServingCarbsG, StringFormat='{}{0:0.0}g'}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#2ECC71" />
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding CarbsDelta, StringFormat='{}{0:+0.0;-0.0;0}'}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <Border Grid.Row="3" Grid.Column="4" CornerRadius="8" Padding="4,1" HorizontalAlignment="Center"
                                Background="{Binding CarbsColor}">
                            <TextBlock Text="{Binding CarbsDeviationPct, StringFormat='{}{0:0}%'}" FontSize="10" Foreground="White" />
                        </Border>

                        <!-- Fat row -->
                        <Border Grid.Row="4" Grid.Column="0" Width="4" Background="#F39C12" VerticalAlignment="Stretch" Margin="0,1" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Fat" FontSize="11" VerticalAlignment="Center" Margin="8,0" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MealTargetFatG, StringFormat='{}{0:0.0}g'}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding PerServingFatG, StringFormat='{}{0:0.0}g'}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#F39C12" />
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding FatDelta, StringFormat='{}{0:+0.0;-0.0;0}'}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <Border Grid.Row="4" Grid.Column="4" CornerRadius="8" Padding="4,1" HorizontalAlignment="Center"
                                Background="{Binding FatColor}">
                            <TextBlock Text="{Binding FatDeviationPct, StringFormat='{}{0:0}%'}" FontSize="10" Foreground="White" />
                        </Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Border Width="10" Height="10" CornerRadius="2" Background="#2ECC71" />
                            <TextBlock Text="&lt;= 15%" FontSize="10" Foreground="Gray" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Border Width="10" Height="10" CornerRadius="2" Background="#F39C12" />
                            <TextBlock Text="15–25%" FontSize="10" Foreground="Gray" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Border Width="10" Height="10" CornerRadius="2" Background="#E74C3C" />
                            <TextBlock Text="> 25%" FontSize="10" Foreground="Gray" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Directions" FontWeight="SemiBold" FontSize="16" Margin="0,8,0,0" />
            <TextBlock Text="{Binding Recipe.Directions}" TextWrapping="Wrap" />

            <TextBlock Text="Notes" FontWeight="SemiBold" FontSize="16" Margin="0,8,0,0"
                       IsVisible="{Binding Recipe.Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding Recipe.Notes}" TextWrapping="Wrap"
                       IsVisible="{Binding Recipe.Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <TextBlock Text="{Binding Recipe.Tags, Converter={x:Static conv:StringJoinConverter.Instance}, StringFormat='Tags: {0}'}"
                       IsVisible="{Binding Recipe.Tags.Count}" Foreground="Gray" Margin="0,8,0,0" />

            <TextBlock Text="{Binding Recipe.Source, StringFormat='Source: {0}'}"
                       IsVisible="{Binding Recipe.Source, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="Gray" FontSize="12" />
            <TextBlock Text="{Binding Recipe.Url}"
                       IsVisible="{Binding Recipe.Url, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="Gray" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
