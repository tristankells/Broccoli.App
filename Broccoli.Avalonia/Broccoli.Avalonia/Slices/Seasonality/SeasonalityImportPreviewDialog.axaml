<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Broccoli.Avalonia.Slices.Seasonality"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="480"
        x:Class="Broccoli.Avalonia.Slices.Seasonality.SeasonalityImportPreviewDialog"
        x:DataType="vm:SeasonalityImportPreviewViewModel"
        Title="Import seasonality data"
        Width="480" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="Import seasonality data" FontSize="18" FontWeight="Bold" />

        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />

        <TextBlock Text="This will replace your current seasonality dataset with the imported items. Local edits that aren't in the file will be lost."
                   FontSize="11" Foreground="Gray" TextWrapping="Wrap" />

        <Border Padding="10" CornerRadius="4" Background="{DynamicResource AppSidebarBackgroundBrush}"
                IsVisible="{Binding HasItems}">
            <StackPanel Spacing="4" MaxHeight="160">
                <TextBlock Text="Will import:" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Text="{Binding SampleNamesText}" TextWrapping="Wrap" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="…" IsVisible="{Binding HasMoreNames}" FontSize="11" Foreground="Gray" />
            </StackPanel>
        </Border>

        <Border Padding="10" CornerRadius="4" Background="{DynamicResource ConflictCardBackgroundBrush}"
                IsVisible="{Binding HasErrors}">
            <StackPanel Spacing="4" MaxHeight="140">
                <TextBlock FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource ConflictCardForegroundBrush}">
                    <Run Text="{Binding SkippedCount, Mode=OneWay}" /><Run Text=" item(s) skipped:" />
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Errors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource ConflictCardForegroundBrush}"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Content="Import" Command="{Binding ConfirmCommand}" Classes="accent"
                    IsEnabled="{Binding HasItems}" />
        </StackPanel>
    </StackPanel>
</Window>
