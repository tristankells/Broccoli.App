<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Broccoli.Avalonia.Slices.Seasonality"
             xmlns:models="using:Broccoli.Avalonia.Models"
             xmlns:conv="using:Broccoli.Avalonia.Shared.Converters"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="450"
             x:Class="Broccoli.Avalonia.Slices.Seasonality.SeasonalityView"
             x:DataType="vm:SeasonalityViewModel">
    <Design.DataContext>
        <vm:SeasonalityViewModel />
    </Design.DataContext>

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Seasonality" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />

        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="Red"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Margin="0,0,0,8" />

        <!-- Month / filter / add controls -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Month" VerticalAlignment="Center" FontSize="12" />
                <ComboBox ItemsSource="{Binding MonthNames}" SelectedIndex="{Binding SelectedMonthIndex}" MinWidth="120" FontSize="12" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Type" VerticalAlignment="Center" FontSize="12" />
                <ComboBox ItemsSource="{Binding TypeFilters}" SelectedIndex="{Binding SelectedTypeFilterIndex}" MinWidth="100" FontSize="12" />
            </StackPanel>
            <TextBox Text="{Binding SearchText}" PlaceholderText="Search..." Width="160" VerticalContentAlignment="Center" FontSize="12" />
            <Button Content="Add" Command="{Binding AddItemCommand}" Padding="16,6" />
            <Button Content="Import" Command="{Binding ImportProduceCommand}" Padding="16,6" />
            <Button Content="Export" Command="{Binding ExportProduceCommand}" Padding="16,6" />
            <Button Content="Reset to defaults" Command="{Binding ResetDataCommand}" Padding="16,6" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Foreground="Gray"
                   FontSize="11" Margin="0,0,0,8"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Current month banner -->
        <Border DockPanel.Dock="Top" Padding="12" CornerRadius="4"
                Background="{DynamicResource AppSidebarBackgroundBrush}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding SeasonBannerText}" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="·" Foreground="Gray" />
                <TextBlock FontSize="12" Foreground="Gray" VerticalAlignment="Center">
                    <Run Text="{Binding InSeasonCount, Mode=OneWay}" />
                    <Run Text="in season" />
                    <Run Text="·" />
                    <Run Text="{Binding PartiallyInSeasonCount, Mode=OneWay}" />
                    <Run Text="partial" />
                    <Run Text="·" />
                    <Run Text="{Binding TotalCount, Mode=OneWay}" />
                    <Run Text="total" />
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="No produce items match the current filters."
                   Foreground="Gray" HorizontalAlignment="Center" FontSize="13"
                   IsVisible="{Binding !FilteredItems.Count}" Margin="0,24,0,0" />

        <!-- Horizontally scrollable grid: the column header stays fixed while the virtualized
             (vertically scrolling) row list scrolls under it. Star-sized columns stretch to fill
             the viewport width (no trailing whitespace) but never collapse below their MinWidths,
             so the table scrolls horizontally instead on narrow windows. -->
        <ScrollViewer x:Name="SeasonalityTableScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Grid RowDefinitions="Auto,*" HorizontalAlignment="Stretch"
                  MinWidth="{Binding Bounds.Width, ElementName=SeasonalityTableScroll}">
                <!-- Column header (dot, name, type then 12 month columns then delete). -->
                <Grid Grid.Row="0" ColumnSpacing="6" Margin="9,0,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="2*" MinWidth="200" />
                        <ColumnDefinition Width="1.2*" MinWidth="90" />
                        <ColumnDefinition Width="1*" MinWidth="96" />
                        <ColumnDefinition Width="1*" MinWidth="96" />
                        <ColumnDefinition Width="1*" MinWidth="96" />
                        <ColumnDefinition Width="1*" MinWidth="96" />
                        <ColumnDefinition Width="1*" MinWidth="96" />
                        <ColumnDefinition Width="1*" MinWidth="96" />
                        <ColumnDefinition Width="1*" MinWidth="96" />
                        <ColumnDefinition Width="1*" MinWidth="96" />
                        <ColumnDefinition Width="1*" MinWidth="96" />
                        <ColumnDefinition Width="1*" MinWidth="96" />
                        <ColumnDefinition Width="1*" MinWidth="96" />
                        <ColumnDefinition Width="1*" MinWidth="96" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Name" FontSize="10" Foreground="Gray" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Type" FontSize="10" Foreground="Gray" VerticalAlignment="Center" />
                    <Border Grid.Column="3" CornerRadius="3" Padding="4,1"
                            Background="{Binding SelectedMonthIndex, Converter={x:Static conv:MonthMatchToBrushConverter.Instance}, ConverterParameter=0}">
                        <TextBlock Text="Jan" FontSize="10" Foreground="Gray" />
                    </Border>
                    <Border Grid.Column="4" CornerRadius="3" Padding="4,1"
                            Background="{Binding SelectedMonthIndex, Converter={x:Static conv:MonthMatchToBrushConverter.Instance}, ConverterParameter=1}">
                        <TextBlock Text="Feb" FontSize="10" Foreground="Gray" />
                    </Border>
                    <Border Grid.Column="5" CornerRadius="3" Padding="4,1"
                            Background="{Binding SelectedMonthIndex, Converter={x:Static conv:MonthMatchToBrushConverter.Instance}, ConverterParameter=2}">
                        <TextBlock Text="Mar" FontSize="10" Foreground="Gray" />
                    </Border>
                    <Border Grid.Column="6" CornerRadius="3" Padding="4,1"
                            Background="{Binding SelectedMonthIndex, Converter={x:Static conv:MonthMatchToBrushConverter.Instance}, ConverterParameter=3}">
                        <TextBlock Text="Apr" FontSize="10" Foreground="Gray" />
                    </Border>
                    <Border Grid.Column="7" CornerRadius="3" Padding="4,1"
                            Background="{Binding SelectedMonthIndex, Converter={x:Static conv:MonthMatchToBrushConverter.Instance}, ConverterParameter=4}">
                        <TextBlock Text="May" FontSize="10" Foreground="Gray" />
                    </Border>
                    <Border Grid.Column="8" CornerRadius="3" Padding="4,1"
                            Background="{Binding SelectedMonthIndex, Converter={x:Static conv:MonthMatchToBrushConverter.Instance}, ConverterParameter=5}">
                        <TextBlock Text="Jun" FontSize="10" Foreground="Gray" />
                    </Border>
                    <Border Grid.Column="9" CornerRadius="3" Padding="4,1"
                            Background="{Binding SelectedMonthIndex, Converter={x:Static conv:MonthMatchToBrushConverter.Instance}, ConverterParameter=6}">
                        <TextBlock Text="Jul" FontSize="10" Foreground="Gray" />
                    </Border>
                    <Border Grid.Column="10" CornerRadius="3" Padding="4,1"
                            Background="{Binding SelectedMonthIndex, Converter={x:Static conv:MonthMatchToBrushConverter.Instance}, ConverterParameter=7}">
                        <TextBlock Text="Aug" FontSize="10" Foreground="Gray" />
                    </Border>
                    <Border Grid.Column="11" CornerRadius="3" Padding="4,1"
                            Background="{Binding SelectedMonthIndex, Converter={x:Static conv:MonthMatchToBrushConverter.Instance}, ConverterParameter=8}">
                        <TextBlock Text="Sep" FontSize="10" Foreground="Gray" />
                    </Border>
                    <Border Grid.Column="12" CornerRadius="3" Padding="4,1"
                            Background="{Binding SelectedMonthIndex, Converter={x:Static conv:MonthMatchToBrushConverter.Instance}, ConverterParameter=9}">
                        <TextBlock Text="Oct" FontSize="10" Foreground="Gray" />
                    </Border>
                    <Border Grid.Column="13" CornerRadius="3" Padding="4,1"
                            Background="{Binding SelectedMonthIndex, Converter={x:Static conv:MonthMatchToBrushConverter.Instance}, ConverterParameter=10}">
                        <TextBlock Text="Nov" FontSize="10" Foreground="Gray" />
                    </Border>
                    <Border Grid.Column="14" CornerRadius="3" Padding="4,1"
                            Background="{Binding SelectedMonthIndex, Converter={x:Static conv:MonthMatchToBrushConverter.Instance}, ConverterParameter=11}">
                        <TextBlock Text="Dec" FontSize="10" Foreground="Gray" />
                    </Border>
                </Grid>

                <!-- Virtualized row list -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsRepeater ItemsSource="{Binding FilteredItems}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProduceItemRowViewModel">
                                <!-- Thin border around the row; the dot shows the current month's
                                     in-season state (green = in, orange = partial, gray = out). -->
                                <Border Margin="0,1" Padding="8,4" CornerRadius="3"
                                        BorderBrush="#40808080" BorderThickness="1">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="2*" MinWidth="200" />
                                            <ColumnDefinition Width="1.2*" MinWidth="90" />
                                            <ColumnDefinition Width="1*" MinWidth="96" />
                                            <ColumnDefinition Width="1*" MinWidth="96" />
                                            <ColumnDefinition Width="1*" MinWidth="96" />
                                            <ColumnDefinition Width="1*" MinWidth="96" />
                                            <ColumnDefinition Width="1*" MinWidth="96" />
                                            <ColumnDefinition Width="1*" MinWidth="96" />
                                            <ColumnDefinition Width="1*" MinWidth="96" />
                                            <ColumnDefinition Width="1*" MinWidth="96" />
                                            <ColumnDefinition Width="1*" MinWidth="96" />
                                            <ColumnDefinition Width="1*" MinWidth="96" />
                                            <ColumnDefinition Width="1*" MinWidth="96" />
                                            <ColumnDefinition Width="1*" MinWidth="96" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Fill="{Binding SeasonColor}" Width="10" Height="10"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 IsHitTestVisible="False" />
                                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                 VerticalContentAlignment="Center" FontSize="12"
                                                 HorizontalAlignment="Stretch" />
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding TypeOptions}"
                                                  SelectedItem="{Binding Type, Mode=TwoWay}" FontSize="11"
                                                  VerticalContentAlignment="Center"
                                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />

                                        <ComboBox Grid.Column="3" ItemsSource="{Binding StateOptions}"
                                                  SelectedItem="{Binding JanuaryState, Mode=TwoWay}"
                                                  Background="{Binding JanuaryState, Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}"
                                                  BorderBrush="#4CAF50"
                                                  BorderThickness="{Binding CurrentMonth, Converter={x:Static conv:MonthMatchToThicknessConverter.Instance}, ConverterParameter=1}"
                                                  FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:SeasonalityState">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                 Fill="{Binding Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}" />
                                                        <TextBlock Text="{Binding Converter={x:Static conv:SeasonalityStateToLabelConverter.Instance}}" FontSize="11" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Grid.Column="4" ItemsSource="{Binding StateOptions}"
                                                  SelectedItem="{Binding FebruaryState, Mode=TwoWay}"
                                                  Background="{Binding FebruaryState, Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}"
                                                  BorderBrush="#4CAF50"
                                                  BorderThickness="{Binding CurrentMonth, Converter={x:Static conv:MonthMatchToThicknessConverter.Instance}, ConverterParameter=2}"
                                                  FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:SeasonalityState">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                 Fill="{Binding Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}" />
                                                        <TextBlock Text="{Binding Converter={x:Static conv:SeasonalityStateToLabelConverter.Instance}}" FontSize="11" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Grid.Column="5" ItemsSource="{Binding StateOptions}"
                                                  SelectedItem="{Binding MarchState, Mode=TwoWay}"
                                                  Background="{Binding MarchState, Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}"
                                                  BorderBrush="#4CAF50"
                                                  BorderThickness="{Binding CurrentMonth, Converter={x:Static conv:MonthMatchToThicknessConverter.Instance}, ConverterParameter=3}"
                                                  FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:SeasonalityState">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                 Fill="{Binding Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}" />
                                                        <TextBlock Text="{Binding Converter={x:Static conv:SeasonalityStateToLabelConverter.Instance}}" FontSize="11" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Grid.Column="6" ItemsSource="{Binding StateOptions}"
                                                  SelectedItem="{Binding AprilState, Mode=TwoWay}"
                                                  Background="{Binding AprilState, Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}"
                                                  BorderBrush="#4CAF50"
                                                  BorderThickness="{Binding CurrentMonth, Converter={x:Static conv:MonthMatchToThicknessConverter.Instance}, ConverterParameter=4}"
                                                  FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:SeasonalityState">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                 Fill="{Binding Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}" />
                                                        <TextBlock Text="{Binding Converter={x:Static conv:SeasonalityStateToLabelConverter.Instance}}" FontSize="11" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Grid.Column="7" ItemsSource="{Binding StateOptions}"
                                                  SelectedItem="{Binding MayState, Mode=TwoWay}"
                                                  Background="{Binding MayState, Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}"
                                                  BorderBrush="#4CAF50"
                                                  BorderThickness="{Binding CurrentMonth, Converter={x:Static conv:MonthMatchToThicknessConverter.Instance}, ConverterParameter=5}"
                                                  FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:SeasonalityState">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                 Fill="{Binding Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}" />
                                                        <TextBlock Text="{Binding Converter={x:Static conv:SeasonalityStateToLabelConverter.Instance}}" FontSize="11" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Grid.Column="8" ItemsSource="{Binding StateOptions}"
                                                  SelectedItem="{Binding JuneState, Mode=TwoWay}"
                                                  Background="{Binding JuneState, Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}"
                                                  BorderBrush="#4CAF50"
                                                  BorderThickness="{Binding CurrentMonth, Converter={x:Static conv:MonthMatchToThicknessConverter.Instance}, ConverterParameter=6}"
                                                  FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:SeasonalityState">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                 Fill="{Binding Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}" />
                                                        <TextBlock Text="{Binding Converter={x:Static conv:SeasonalityStateToLabelConverter.Instance}}" FontSize="11" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Grid.Column="9" ItemsSource="{Binding StateOptions}"
                                                  SelectedItem="{Binding JulyState, Mode=TwoWay}"
                                                  Background="{Binding JulyState, Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}"
                                                  BorderBrush="#4CAF50"
                                                  BorderThickness="{Binding CurrentMonth, Converter={x:Static conv:MonthMatchToThicknessConverter.Instance}, ConverterParameter=7}"
                                                  FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:SeasonalityState">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                 Fill="{Binding Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}" />
                                                        <TextBlock Text="{Binding Converter={x:Static conv:SeasonalityStateToLabelConverter.Instance}}" FontSize="11" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Grid.Column="10" ItemsSource="{Binding StateOptions}"
                                                  SelectedItem="{Binding AugustState, Mode=TwoWay}"
                                                  Background="{Binding AugustState, Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}"
                                                  BorderBrush="#4CAF50"
                                                  BorderThickness="{Binding CurrentMonth, Converter={x:Static conv:MonthMatchToThicknessConverter.Instance}, ConverterParameter=8}"
                                                  FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:SeasonalityState">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                 Fill="{Binding Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}" />
                                                        <TextBlock Text="{Binding Converter={x:Static conv:SeasonalityStateToLabelConverter.Instance}}" FontSize="11" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Grid.Column="11" ItemsSource="{Binding StateOptions}"
                                                  SelectedItem="{Binding SeptemberState, Mode=TwoWay}"
                                                  Background="{Binding SeptemberState, Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}"
                                                  BorderBrush="#4CAF50"
                                                  BorderThickness="{Binding CurrentMonth, Converter={x:Static conv:MonthMatchToThicknessConverter.Instance}, ConverterParameter=9}"
                                                  FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:SeasonalityState">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                 Fill="{Binding Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}" />
                                                        <TextBlock Text="{Binding Converter={x:Static conv:SeasonalityStateToLabelConverter.Instance}}" FontSize="11" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Grid.Column="12" ItemsSource="{Binding StateOptions}"
                                                  SelectedItem="{Binding OctoberState, Mode=TwoWay}"
                                                  Background="{Binding OctoberState, Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}"
                                                  BorderBrush="#4CAF50"
                                                  BorderThickness="{Binding CurrentMonth, Converter={x:Static conv:MonthMatchToThicknessConverter.Instance}, ConverterParameter=10}"
                                                  FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:SeasonalityState">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                 Fill="{Binding Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}" />
                                                        <TextBlock Text="{Binding Converter={x:Static conv:SeasonalityStateToLabelConverter.Instance}}" FontSize="11" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Grid.Column="13" ItemsSource="{Binding StateOptions}"
                                                  SelectedItem="{Binding NovemberState, Mode=TwoWay}"
                                                  Background="{Binding NovemberState, Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}"
                                                  BorderBrush="#4CAF50"
                                                  BorderThickness="{Binding CurrentMonth, Converter={x:Static conv:MonthMatchToThicknessConverter.Instance}, ConverterParameter=11}"
                                                  FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:SeasonalityState">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                 Fill="{Binding Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}" />
                                                        <TextBlock Text="{Binding Converter={x:Static conv:SeasonalityStateToLabelConverter.Instance}}" FontSize="11" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Grid.Column="14" ItemsSource="{Binding StateOptions}"
                                                  SelectedItem="{Binding DecemberState, Mode=TwoWay}"
                                                  Background="{Binding DecemberState, Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}"
                                                  BorderBrush="#4CAF50"
                                                  BorderThickness="{Binding CurrentMonth, Converter={x:Static conv:MonthMatchToThicknessConverter.Instance}, ConverterParameter=12}"
                                                  FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:SeasonalityState">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                 Fill="{Binding Converter={x:Static conv:SeasonalityStateToColorConverter.Instance}}" />
                                                        <TextBlock Text="{Binding Converter={x:Static conv:SeasonalityStateToLabelConverter.Instance}}" FontSize="11" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <Button Grid.Column="15" Padding="4" VerticalAlignment="Center"
                                                Command="{Binding $parent[ItemsRepeater].((vm:SeasonalityViewModel)DataContext).DeleteItemCommand}"
                                                CommandParameter="{Binding}">
                                            <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                                      Width="10" Height="10" Foreground="Red" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
