<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Broccoli.Avalonia.Slices.Seasonality"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
             x:Class="Broccoli.Avalonia.Slices.Seasonality.SeasonalityView"
             x:DataType="vm:SeasonalityViewModel">
    <Design.DataContext>
        <vm:SeasonalityViewModel />
    </Design.DataContext>

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Seasonality" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />

        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="Red"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Margin="0,0,0,8" />

        <!-- Month / filter / add controls -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Month" VerticalAlignment="Center" FontSize="12" />
                <ComboBox ItemsSource="{Binding MonthNames}" SelectedIndex="{Binding SelectedMonthIndex}" MinWidth="120" FontSize="12" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Type" VerticalAlignment="Center" FontSize="12" />
                <ComboBox ItemsSource="{Binding TypeFilters}" SelectedIndex="{Binding SelectedTypeFilterIndex}" MinWidth="100" FontSize="12" />
            </StackPanel>
            <TextBox Text="{Binding SearchText}" PlaceholderText="Search..." Width="160" VerticalContentAlignment="Center" FontSize="12" />
            <Button Content="Add" Command="{Binding AddItemCommand}" Padding="16,6" />
            <Button Content="Reset to defaults" Command="{Binding ResetDataCommand}" Padding="16,6" />
        </StackPanel>

        <!-- Current season banner -->
        <Border DockPanel.Dock="Top" Padding="12" CornerRadius="4"
                Background="{DynamicResource AppSidebarBackgroundBrush}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding SeasonBannerText}" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="·" Foreground="Gray" />
                <TextBlock FontSize="12" Foreground="Gray" VerticalAlignment="Center">
                    <Run Text="{Binding InSeasonCount, Mode=OneWay}" />
                    <Run Text="of" />
                    <Run Text="{Binding TotalCount, Mode=OneWay}" />
                    <Run Text="items in season" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Column header (outside the scrolling region so it stays put) -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="10,*,110,Auto,Auto,Auto,Auto,Auto,Auto"
              ColumnSpacing="8" Margin="8,0,8,2">
            <TextBlock Grid.Column="1" Text="Name" FontSize="10" Foreground="Gray" />
            <TextBlock Grid.Column="2" Text="Type" FontSize="10" Foreground="Gray" />
            <TextBlock Grid.Column="3" Text="Spring" FontSize="10" Foreground="Gray" />
            <TextBlock Grid.Column="4" Text="Summer" FontSize="10" Foreground="Gray" />
            <TextBlock Grid.Column="5" Text="Autumn" FontSize="10" Foreground="Gray" />
            <TextBlock Grid.Column="6" Text="Winter" FontSize="10" Foreground="Gray" />
            <TextBlock Grid.Column="7" Text="Year-round" FontSize="10" Foreground="Gray" />
        </Grid>

        <TextBlock DockPanel.Dock="Top" Text="No produce items match the current filters."
                   Foreground="Gray" HorizontalAlignment="Center" FontSize="13"
                   IsVisible="{Binding !FilteredItems.Count}" Margin="0,24,0,0" />

        <!-- Virtualized list: ItemsRepeater realizes only the visible rows, so opening the tab
             (or rebuilding the view on navigation) no longer measures all ~75 rows at once. -->
        <ScrollViewer>
            <ItemsRepeater ItemsSource="{Binding FilteredItems}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProduceItemRowViewModel">
                        <Border Margin="0,1" Padding="8,4" CornerRadius="2"
                                BorderBrush="{Binding SeasonColor}" BorderThickness="3,0,0,0">
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="10,*,110,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                    <Ellipse Grid.Column="0" Fill="{Binding SeasonColor}" Width="10" Height="10"
                                             VerticalAlignment="Center" IsHitTestVisible="False" />
                                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                             VerticalContentAlignment="Center" FontSize="12" />
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding TypeOptions}"
                                              SelectedItem="{Binding Type, Mode=TwoWay}" FontSize="11"
                                              VerticalContentAlignment="Center" />
                                    <CheckBox Grid.Column="3" IsChecked="{Binding InSpring, Mode=TwoWay}"
                                              IsEnabled="{Binding CanEditSeasons}" VerticalAlignment="Center">
                                        <TextBlock Text="Spring" FontSize="11" />
                                    </CheckBox>
                                    <CheckBox Grid.Column="4" IsChecked="{Binding InSummer, Mode=TwoWay}"
                                              IsEnabled="{Binding CanEditSeasons}" VerticalAlignment="Center">
                                        <TextBlock Text="Summer" FontSize="11" />
                                    </CheckBox>
                                    <CheckBox Grid.Column="5" IsChecked="{Binding InAutumn, Mode=TwoWay}"
                                              IsEnabled="{Binding CanEditSeasons}" VerticalAlignment="Center">
                                        <TextBlock Text="Autumn" FontSize="11" />
                                    </CheckBox>
                                    <CheckBox Grid.Column="6" IsChecked="{Binding InWinter, Mode=TwoWay}"
                                              IsEnabled="{Binding CanEditSeasons}" VerticalAlignment="Center">
                                        <TextBlock Text="Winter" FontSize="11" />
                                    </CheckBox>
                                    <CheckBox Grid.Column="7" IsChecked="{Binding YearRound, Mode=TwoWay}" VerticalAlignment="Center">
                                        <TextBlock Text="Year-round" FontSize="11" />
                                    </CheckBox>
                                    <Button Grid.Column="8" Padding="4" VerticalAlignment="Center"
                                            Command="{Binding $parent[ItemsRepeater].((vm:SeasonalityViewModel)DataContext).DeleteItemCommand}"
                                            CommandParameter="{Binding}">
                                        <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                                  Width="10" Height="10" Foreground="Red" />
                                    </Button>
                                </Grid>
                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=LostFocus}"
                                         PlaceholderText="Notes..." FontSize="11" MinHeight="24"
                                         Margin="18,0,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </DockPanel>
</UserControl>
