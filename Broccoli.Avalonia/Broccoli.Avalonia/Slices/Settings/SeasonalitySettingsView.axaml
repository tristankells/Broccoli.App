<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Broccoli.Avalonia.Slices.Settings"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
             x:Class="Broccoli.Avalonia.Slices.Settings.SeasonalitySettingsView"
             x:DataType="vm:SeasonalitySettingsViewModel">
    <Design.DataContext>
        <vm:SeasonalitySettingsViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Margin="16" Spacing="16" MaxWidth="500">
            <TextBlock Text="Seasonality" FontWeight="Bold" FontSize="16" />

            <Border Padding="12" CornerRadius="4" Background="{DynamicResource AppSidebarBackgroundBrush}">
                <StackPanel Spacing="6">
                    <CheckBox IsChecked="{Binding ShowSeasonalityNavItem}">
                        <TextBlock Text="Show Seasonality tab in navigation" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock Text="Uncheck to hide the Seasonality page from the sidebar. Edits you have made to the produce data are kept either way."
                               FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Padding="12" CornerRadius="4" Background="{DynamicResource AppSidebarBackgroundBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Recipe traffic light" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="Recipes are classified Green, Yellow or Red for the scored date. The top third of your recipe library is Green and the bottom third Red, unless these absolute bounds override the ranking."
                               FontSize="11" Foreground="Gray" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Always Green above:" Width="150" FontSize="12" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding GreenAlwaysHigh}" Minimum="0" Maximum="100" Increment="5"
                                       Width="100" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Green floor:" Width="150" FontSize="12" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding GreenFloor}" Minimum="0" Maximum="100" Increment="5"
                                       Width="100" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Red ceiling:" Width="150" FontSize="12" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding RedCeiling}" Minimum="0" Maximum="100" Increment="5"
                                       Width="100" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Always Red below:" Width="150" FontSize="12" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding RedAlwaysLow}" Minimum="0" Maximum="100" Increment="5"
                                       Width="100" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="12" CornerRadius="4" Background="{DynamicResource AppSidebarBackgroundBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Ingredient influence" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="How much a short-season ingredient counts toward the score compared to a year-round staple (carrot, garlic, onion). A higher influence makes a scarce out-of-season ingredient pull the score down more."
                               FontSize="11" Foreground="Gray" TextWrapping="Wrap" />

                    <ComboBox ItemsSource="{Binding InfluenceModeOptions}"
                              SelectedItem="{Binding SelectedInfluenceOption}"
                              HorizontalAlignment="Left" MinWidth="280">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:InfluenceModeOption">
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="Gray" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Padding="12" CornerRadius="4" Background="{DynamicResource AppSidebarBackgroundBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Library ranking" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="Which slices of your recipe library are Green (top) and Red (bottom) relative to each other for the scored date. Lower Green % means more recipes rank as Green."
                               FontSize="11" Foreground="Gray" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Green ranks in top:" Width="150" FontSize="12" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding TopThirdPercent}" Minimum="1" Maximum="99" Increment="1"
                                       Width="100" VerticalAlignment="Center" />
                        <TextBlock Text="%" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Red ranks in bottom:" Width="150" FontSize="12" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding BottomThirdPercent}" Minimum="1" Maximum="99" Increment="1"
                                       Width="100" VerticalAlignment="Center" />
                        <TextBlock Text="%" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="Gray"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Button Content="Save Settings" Command="{Binding SaveCommand}" Classes="accent"
                    HorizontalAlignment="Left" Padding="12,6" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
