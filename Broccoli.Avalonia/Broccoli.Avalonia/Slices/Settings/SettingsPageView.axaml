<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Broccoli.Avalonia.Slices.Settings"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Broccoli.Avalonia.Slices.Settings.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">
    <Design.DataContext>
        <vm:SettingsPageViewModel />
    </Design.DataContext>

    <TabControl SelectedIndex="{Binding CurrentTabIndex}">
        <TabItem Header="Sync">
            <ScrollViewer>
                <ContentControl Content="{Binding Sync}" />
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Recipes">
            <ScrollViewer>
                <ContentControl Content="{Binding RecipeSettings}" />
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Food Database">
            <ScrollViewer>
                <ContentControl Content="{Binding FoodDatabase}" />
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Seasonality">
            <ScrollViewer>
                <ContentControl Content="{Binding SeasonalitySettings}" />
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
