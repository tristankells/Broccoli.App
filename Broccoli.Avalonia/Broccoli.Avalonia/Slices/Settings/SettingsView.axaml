<UserControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:vm="using:Broccoli.Avalonia.Slices.Settings"
                xmlns:sync="using:Broccoli.Avalonia.Slices.Settings.Sync"
                mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="420"
                x:Class="Broccoli.Avalonia.Slices.Settings.SettingsView"
                x:DataType="vm:SettingsViewModel">
    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <StackPanel Width="320" Spacing="12" Margin="16">
        <TextBlock Text="Settings" FontWeight="Bold" FontSize="16" />

        <StackPanel Spacing="6">
            <TextBlock Text="Google Drive Backup" FontWeight="SemiBold" />

            <StackPanel IsVisible="{Binding IsBusy}" Spacing="4" Margin="0,2,0,0">
                <ProgressBar Minimum="0" Maximum="1"
                             Value="{Binding ProgressValue}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}" />
                <TextBlock Text="{Binding ProgressMessage}"
                           IsVisible="{Binding ProgressMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsConnected}" Spacing="4">
                <TextBlock Text="{Binding ConnectedEmail, StringFormat='Connected as {0}'}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding ConnectedAtUtc, StringFormat='Since {0:d MMM yyyy}'}"
                           Foreground="Gray" FontSize="12" />
                <TextBlock Text="{Binding LastSyncedAtUtc, StringFormat='Last synced {0:d MMM yyyy h:mm tt}'}"
                           IsVisible="{Binding LastSyncedAtUtc, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Foreground="Gray" FontSize="12" />
                <TextBlock Text="Never synced yet" Foreground="Gray" FontSize="12"
                           IsVisible="{Binding LastSyncedAtUtc, Converter={x:Static ObjectConverters.IsNull}}" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button Content="Sync now"
                            Command="{Binding SyncNowCommand}"
                            IsEnabled="{Binding !IsSyncing}" />
                    <Button Content="Disconnect"
                            Command="{Binding DisconnectCommand}"
                            IsEnabled="{Binding !IsConnecting}" />
                </StackPanel>

                <TextBlock Text="{Binding SyncStatusMessage}"
                           IsVisible="{Binding SyncStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="Gray" FontSize="12" TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding Conflicts}" Margin="0,8,0,0"
                              IsVisible="{Binding HasConflicts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sync:SyncConflict">
                            <Border Background="{DynamicResource ConflictCardBackgroundBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding DisplayName, StringFormat='Conflict: {0}'}"
                                               Foreground="{DynamicResource ConflictCardForegroundBrush}"
                                               FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12" />
                                    <TextBlock Text="Changed on this device and in Drive since the last sync."
                                               Foreground="{DynamicResource ConflictCardForegroundBrush}"
                                               FontSize="11" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Keep mine"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).KeepLocalCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Use Drive version"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).UseDriveCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel IsVisible="{Binding !IsConnected}" Spacing="4">
                <TextBlock Text="Not connected. Connect a Google account to automatically back up your data to Drive."
                           TextWrapping="Wrap" Foreground="Gray" FontSize="12" />
                <Button Content="Connect Google Drive"
                        Command="{Binding ConnectCommand}"
                        IsEnabled="{Binding !IsConnecting}"
                        HorizontalAlignment="Left" Margin="0,4,0,0" />
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="Red" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
    </StackPanel>
</UserControl>

